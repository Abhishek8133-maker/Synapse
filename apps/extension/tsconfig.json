{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2020"],
    "types": ["chrome"],
    "paths": {
      "@/*": ["./src/*"],
      "@synapse/shared-types": ["../../packages/shared-types/src"],
      "@synapse/ui": ["../../packages/ui/src"],
      "@synapse/utils": ["../../packages/utils/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}